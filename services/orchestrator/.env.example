# Copy to .env and fill in values before starting the orchestrator.

READINESS_MODE=dev
RENDERFLOW_HTTP_PORT=8080

# Postgres
DATABASE_URL=postgresql://renderflow:renderflow@127.0.0.1:5432/renderflow

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Set to true once model weights are downloaded and the worker is running.
# With REDIS_URL set, scene jobs are dispatched to model-workers' redis_worker;
# without Redis, the orchestrator runs RFIR in-process via the app.rfir bridge
# (requires torch/diffusers/transformers in this venv for real inference).
RENDERFLOW_RFIR_ENABLED=false
RENDERFLOW_MODELS_DIR=$HOME/renderflow-models

# Optional: where the app.rfir bridge finds model-workers' RFIR sources.
# Defaults to ../model-workers/app/rfir relative to this service.
# RENDERFLOW_RFIR_PACKAGE_DIR=

