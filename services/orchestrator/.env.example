# Copy to .env and fill in values before starting the orchestrator.

READINESS_MODE=dev
RENDERFLOW_HTTP_PORT=8080

# Postgres
DATABASE_URL=postgresql://renderflow:renderflow@127.0.0.1:5432/renderflow

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Set to true once model weights are downloaded and the worker is running
RENDERFLOW_RFIR_ENABLED=false
RENDERFLOW_MODELS_DIR=$HOME/renderflow-models
