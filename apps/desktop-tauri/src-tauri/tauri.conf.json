{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renderflow Studio",
  "version": "0.1.0",
  "identifier": "ai.deepiri.renderflow",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Renderflow Studio",
        "width": 1600,
        "height": 980
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Renderflow Studio",
    "copyright": "Renderflow Studio"
  }
}
